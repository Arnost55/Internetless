/dts-v1/;
/plugin/;

/ {
    compatible = "brcm,bcm2712", "brcm,bcm2711";

    fragment@0 {
        target = <&pcie>;
        __overlay__ {
            /* Enable PCIe Gen 3 (8 GT/s) on Pi 5 */
            status = "okay";
            ranges = <0x02000000 0x00000000 0x00000000 0x00000000 0x02000000 0x00200000>;
            num-lanes = <1>;
            max-link-speed = <3>;  /* Gen 3 = 8 GT/s */
            aspm = <0x1>;  /* L0s and L1 */
            pcie@0 {
                #address-cells = <3>;
                #size-cells = <2>;
                device_type = "pci";
                ranges = <0x82000000 0 0x00000000 0x00000000 0x00000000 0x00100000>;
                reg = <0x00000000 0 0x00000000 0 0x00100000>;
                interrupt-map-mask = <0 0 0 0x7>;
                interrupt-map = <0 0 0 1 &gic 0 160 4>,
                                <0 0 0 2 &gic 0 161 4>,
                                <0 0 0 3 &gic 0 162 4>,
                                <0 0 0 4 &gic 0 163 4>;
            };
        };
    };

    fragment@1 {
        target = <&i2c1>;
        __overlay__ {
            /* 0.96" SSD1306 OLED on I2C1 (GPIO2/3) */
            status = "okay";
            ssd1306@3c {
                compatible = "solomon,ssd1306fb-i2c";
                reg = <0x3c>;
                width = <128>;
                height = <64>;
                page-offset = <0>;
                segment-offset = <0>;
                com-invdir;
                com-seq;
                charge-pump-voltage = <0x30>;
                prechargep1 = <0x1f>;
                prechargep2 = <0xf>;
                vcomh = <0x40>;
                contrast = <0xff>;
                inversion;
            };
        };
    };

    fragment@2 {
        target = <&gpio>;
        __overlay__ {
            /* UPS Battery Monitor - ADC on GPIO26 (ADC0) */
            ups_monitor: ups_monitor {
                compatible = "internetless,ups-monitor";
                status = "okay";
                adc-channel = <0>;  /* GPIO26 = ADC0 */
                gpios = <&gpio 26 GPIO_ACTIVE_HIGH>;
                voltage-divider-r1 = <100000>;  /* 100k upper */
                voltage-divider-r2 = <10000>;   /* 10k lower = 11:1 divider */
                min-voltage-mv = <3000>;
                max-voltage-mv = <4200>;
                poll-interval-ms = <5000>;
            };

            /* Power status LED */
            power_led: power_led {
                compatible = "gpio-leds";
                status = "okay";
                led-gpios = <&gpio 27 GPIO_ACTIVE_HIGH>;
                default-state = "keep";
            };

            /* Cartridge presence detection (8 GPIOs) */
            cartridge_detect: cartridge_detect {
                compatible = "internetless,cartridge-detect";
                status = "okay";
                gpios = <&gpio 5 GPIO_ACTIVE_LOW>,   /* Slot 1 */
                        <&gpio 6 GPIO_ACTIVE_LOW>,   /* Slot 2 */
                        <&gpio 13 GPIO_ACTIVE_LOW>,  /* Slot 3 */
                        <&gpio 19 GPIO_ACTIVE_LOW>,  /* Slot 4 */
                        <&gpio 20 GPIO_ACTIVE_LOW>,  /* Slot 5 */
                        <&gpio 21 GPIO_ACTIVE_LOW>,  /* Slot 6 */
                        <&gpio 12 GPIO_ACTIVE_LOW>,  /* Slot 7 */
                        <&gpio 16 GPIO_ACTIVE_LOW>;  /* Slot 8 */
            };
        };
    };

    fragment@3 {
        target = <&spi0>;
        __overlay__ {
            /* Optional: SPI for additional sensors */
            status = "okay";
        };
    };

    fragment@4 {
        target = <&uart1>;
        __overlay__ {
            /* Optional: Serial console / modem AT commands */
            status = "okay";
        };
    };
};

/* Compile with:
 *   dtc -@ -I dts -O dtb -o internetless-overlay.dtbo internetless-overlay.dts
 * Install:
 *   sudo cp internetless-overlay.dtbo /boot/firmware/overlays/
 * Enable in config.txt:
 *   dtoverlay=internetless-overlay
 */